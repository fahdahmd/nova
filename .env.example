# ---------------------------------------------------------------------------
# Nova configuration. Copy to .env and edit. NEVER commit your .env file.
# Every value below is optional - these are the built-in defaults.
# ---------------------------------------------------------------------------

# ----------------------------- application ---------------------------------
NOVA_APP_NAME=Nova
NOVA_ENVIRONMENT=prod
# Open the browser automatically on startup.
NOVA_OPEN_BROWSER=true

# ------------------------------- server ------------------------------------
# Loopback addresses only. Any other value is rejected at startup.
NOVA_HOST=127.0.0.1
NOVA_PORT=8765
# Leave unset to generate a fresh random session token on every start
# (recommended). Set it only if you want a stable bookmarkable URL.
# NOVA_AUTH_TOKEN=

# -------------------------------- LLM --------------------------------------
NOVA_OLLAMA_HOST=http://127.0.0.1:11434
NOVA_OLLAMA_MODEL=qwen3.5:4b
NOVA_OLLAMA_TIMEOUT_S=120
# How long Ollama keeps the model in memory between messages. Reloading it
# costs several seconds plus a full prompt re-evaluation, so keep this
# comfortably longer than the gaps between your messages.
NOVA_OLLAMA_KEEP_ALIVE=30m
# Thinking is off by default for speed. Turn on for harder reasoning.
NOVA_OLLAMA_THINK=false
NOVA_TEMPERATURE=0.2
NOVA_TOP_P=0.9
# A smaller window means a smaller KV cache and faster prompt processing.
# The system prompt and tool schemas already take ~2,300 tokens, so the
# history budget must leave room: budget <= num_ctx - 2800.
NOVA_NUM_CTX=4096
NOVA_CONTEXT_TOKEN_BUDGET=1200
NOVA_MAX_TOOL_ITERATIONS=4
NOVA_TOOL_TIMEOUT_S=20
NOVA_HISTORY_TURNS=12

# ----------------------- speech to text (whisper) --------------------------
NOVA_STT_ENABLED=true
# tiny | base | small | medium | large-v3
NOVA_WHISPER_MODEL=base
NOVA_WHISPER_DEVICE=cpu
NOVA_WHISPER_COMPUTE_TYPE=int8
# Set to an empty value for automatic language detection.
NOVA_WHISPER_LANGUAGE=en
NOVA_WHISPER_BEAM_SIZE=1

# ------------------------ text to speech (piper) ---------------------------
NOVA_TTS_ENABLED=true
# Run scripts/download_voice.py to fetch a voice into models/piper/.
NOVA_PIPER_VOICE_PATH=models/piper/en_US-amy-medium.onnx
# Higher is slower speech (0.5 = fast, 2.0 = slow).
NOVA_PIPER_LENGTH_SCALE=1.0
NOVA_TTS_CHUNK_CHARS=180

# --------------------------------- VAD -------------------------------------
NOVA_VAD_ENABLED=true
# 0 (permissive) to 3 (aggressive filtering of non-speech)
NOVA_VAD_AGGRESSIVENESS=2
NOVA_VAD_SILENCE_MS=900
NOVA_VAD_MIN_SPEECH_MS=250

# ------------------------------ wake word ----------------------------------
# Requires the optional extra:  uv pip install -e ".[wakeword]"
NOVA_WAKEWORD_ENABLED=false
NOVA_WAKEWORD_MODEL=alexa
NOVA_WAKEWORD_THRESHOLD=0.6

# -------------------------------- tools ------------------------------------
# Both network tools can be switched off completely.
NOVA_WEATHER_ENABLED=true
NOVA_WEB_SEARCH_ENABLED=true
NOVA_WEB_SEARCH_MAX_RESULTS=5
# Default coordinates used when you do not name a city.
# NOVA_WEATHER_LATITUDE=24.8607
# NOVA_WEATHER_LONGITUDE=67.0011
# NOVA_WEATHER_LOCATION_NAME=Karachi

# Filesystem sandbox: JSON array of absolute paths. Reads are confined to
# these roots; the first one is the "default" root (reads there need no
# confirmation). Use forward slashes on Windows too.
# NOVA_ALLOWED_ROOTS=["C:/Users/me/Documents","C:/Users/me/Downloads"]

# Application whitelist: JSON object of id -> {label, argv}. Nova can launch
# nothing that is not listed here, and never through a shell.
# NOVA_ALLOWED_APPS={"notepad":{"label":"Notepad","argv":["notepad.exe"]},"calculator":{"label":"Calculator","argv":["calc.exe"]}}

# ------------------------------- storage -----------------------------------
NOVA_DB_PATH=data/nova.db

# -------------------------------- limits -----------------------------------
NOVA_MAX_MESSAGE_CHARS=4000
NOVA_MAX_AUDIO_SECONDS=60
NOVA_MAX_AUDIO_BYTES=10485760
NOVA_MAX_FILE_BYTES=524288
NOVA_MAX_WS_MESSAGE_BYTES=524288
NOVA_HTTP_RATE_LIMIT=180
NOVA_HTTP_RATE_WINDOW_S=60
NOVA_WS_RATE_LIMIT=60
NOVA_WS_RATE_WINDOW_S=60

# ------------------------------- logging -----------------------------------
# DEBUG | INFO | WARNING | ERROR
NOVA_LOG_LEVEL=INFO
NOVA_LOG_JSON=false
# NOVA_LOG_FILE=logs/nova.log
